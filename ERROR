- task: AzureCLI@2
  displayName: Import OpenAPI
  inputs:
    azureSubscription: $(azureSubscription)
    scriptType: bash
    scriptLocation: inlineScript

    inlineScript: |
      set -euo pipefail

      OPENAPI_FILE="$(Pipeline.Workspace)/openapi/openapi.json"

      echo "====================="
      echo "OpenAPI being imported:"
      echo "====================="

      if [ ! -f "$OPENAPI_FILE" ]; then
        echo "ERROR: OpenAPI file not found:"
        echo "$OPENAPI_FILE"
        exit 1
      fi

      echo ""
      echo "Endpoints in OpenAPI:"

      jq -r '
        .paths
        | to_entries[]
        | .key as $path
        | .value
        | keys[]
        | "\(. | ascii_upcase) \($path)"
      ' "$OPENAPI_FILE"

      echo ""
      echo "====================="
      echo "Importing OpenAPI into APIM"
      echo "====================="

      az apim api import \
        --resource-group "$(apimResourceGroup)" \
        --service-name "$(apimServiceName)" \
        --api-id "$(apimApiId)" \
        --path "$(apimApiPath)" \
        --display-name "$(apimApiId)" \
        --specification-format OpenApiJson \
        --specification-path "$OPENAPI_FILE"

      echo ""
      echo "✅ OpenAPI import completed successfully."
