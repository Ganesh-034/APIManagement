import express from "express";

const router = express.Router();

/**
 * @openapi
 * /api/apim-policy-test:
 *   post:
 *     summary: Test APIM policy automation
 *     description: Temporary API for validating policy automation behavior.
 *     operationId: apimPolicyTest
 *     tags:
 *       - APIM Testing
 *     responses:
 *       200:
 *         description: APIM policy test successful
 */
router.post("/", (req, res) => {
  res.status(200).json({
    message: "APIM policy automation test successful",
    status: "success",
  });
});

export default router;
