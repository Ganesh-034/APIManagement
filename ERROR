  - stage: Build_Presidio
    displayName: Build Presidio
    dependsOn: 
      - DetectChanges
      - Security
    condition: >
      and(
        succeeded(),
        eq(dependencies.DetectChanges.outputs['PathAnalysis.DetectPaths.deployPresidio'], 'true')
      )
    jobs:
      - job: Build
        displayName: Build & Push
        steps:
          - checkout: self
          - task: AzureCLI@2
            name: BuildPush
            displayName: Build & Push Image
            inputs:
              azureSubscription: $(azureSubscription)
              scriptType: bash
              scriptLocation: inlineScript
              inlineScript: >
                set -euo pipefail


                ACR="$(presidio.registryName)"

                REPO="$(presidio.containerRepository)"

                TAG="$(Build.BuildId)"

                IMAGE="${ACR}.azurecr.io/${REPO}:${TAG}"


                BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

                GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")


                PRESIDIO_DIR="$(Build.SourcesDirectory)/src/services/security/presidio"


                echo "======================================"

                echo "Building Presidio Image"

                echo "======================================"

                echo "Image: ${IMAGE}"

                echo "Commit: ${GIT_COMMIT}"

                echo ""


                cd "${PRESIDIO_DIR}"


                az acr build \
                  --registry "${ACR}" \
                  --image "${REPO}:${TAG}" \
                  --build-arg BUILD_DATE="${BUILD_DATE}" \
                  --build-arg VCS_REF="${GIT_COMMIT}" \
                  --build-arg VERSION="${TAG}" \
                  --file Dockerfile \
                  --platform linux/amd64 \
                  . || {
                    echo "ACR build failed, trying local build..."
                    az acr login --name "${ACR}"
                    docker build -t "${IMAGE}" -f Dockerfile .
                    docker push "${IMAGE}"
                  }

                echo ""

                echo "✓ Build completed"

                echo "##vso[task.setvariable variable=image;isOutput=true]${IMAGE}"
  
  - stage: Scan_Watchtower
    displayName: " Scan Watchtower"
    dependsOn: Build_Watchtower
    condition: |
      and(
        succeeded(),
        eq(variables['EnableTrivy'], 'true')
      )
    variables:
      image: $[ stageDependencies.Build_Watchtower.Build.outputs['BuildPush.image'] ]
    jobs:
      - job: Trivy
        displayName: Trivy Scan
        steps:
          - checkout: none
          - bash: >
              set -euo pipefail


              echo "Installing Trivy..."

              wget -qO - https://aquasecurity.github.io/trivy-repo/deb/public.key | sudo apt-key add -

              echo "deb https://aquasecurity.github.io/trivy-repo/deb $(lsb_release -sc) main" | sudo tee /etc/apt/sources.list.d/trivy.list

              sudo apt-get update

              sudo apt-get install -y trivy
            displayName: Install Trivy
          - task: AzureCLI@2
            displayName: Scan Image
            inputs:
              azureSubscription: $(azureSubscription)
              scriptType: bash
              scriptLocation: inlineScript
              inlineScript: |
                set -euo pipefail

                az acr login --name "$(watchtower.registryName)"

                echo "======================================"
                echo "Scanning Watchtower Image"
                echo "======================================"
                echo "Image: $(image)"
                echo ""

                # Ensure reports directory exists
                mkdir -p reports

                # Run Trivy scan
                trivy image \
                  --severity CRITICAL,HIGH \
                  --format sarif \
                  --output reports/trivy.sarif \
                  "$(image)" || true

                trivy image \
                  --severity CRITICAL,HIGH,MEDIUM \
                  --format table \
                  "$(image)" || true

                # Ensure file exists
                if [ ! -f reports/trivy.sarif ]; then
                  echo '{"version":"2.1.0","runs":[]}' > reports/trivy.sarif
                fi

                echo ""
                echo "✓ Scan completed (informational)"
            continueOnError: true
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/reports/trivy.sarif
              artifactName: trivy-watchtower
            displayName: Publish Trivy Report
  
