  - stage: APIM_Test
    displayName: APIM Automation Test
    dependsOn:
      - Build_Watchtower
    condition: succeeded()

    jobs:
      - job: Import_APIM
        steps:
        - checkout: self
        - task: DownloadPipelineArtifact@2
          inputs:
            artifactName: openapi-files
            targetPath: $(Pipeline.Workspace)/openapi
        - bash: |
            echo "Download OpenAPI files:"
            find $(Pipeline.Workspace)/openapi -type f
            echo ""
            ls -R $(Pipeline.Workspace)/openapi
          displayName: Verify OpenAPI Artifact

        - bash: |
            echo "===OpenAPI Title ==="
            grep -A5 -B2 '"title"' $(Pipeline.Workspace)/openapi/openapi.json || true
            echo ""
            echo "openAPI Info"              
            cat $(Pipeline.Workspace)/openapi/openapi.json | jq '.info'
          displayName: Inspect OpenAPI 
        - task: AzureCLI@2
          displayName: List Existing APIs
          inputs:
            azureSubscription: $(azureSubscription)
            scriptType: bash
            scriptLocation: inlineScript
            inlineScript: |
              az apim api list \
                --resource-group "$(apimResourceGroup)" \
                --service-name "$(apimServiceName)" \
                -o table
        - task: AzureCLI@2
          displayName: Show Current API
          inputs:
            azureSubscription: $(azureSubscription)
            scriptType: bash
            scriptLocation: inlineScript
            inlineScript: |
              az apim api show \
                --resource-group "$(apimResourceGroup)" \
                --service-name "$(apimServiceName)" \
                --api-id "$(apimApiId)"

       - task: AzureCLI@2
         displayName: Import OpenAPI
         inputs:
           azureSubscription: $(azureSubscription)
           scriptType: bash
           scriptLocation: inlineScript

           inlineScript: |
             set -euo pipefail

             OPENAPI_FILE="$(Pipeline.Workspace)/openapi/openapi.json"

             echo "====================="
             echo "OpenAPI being imported:"
             echo "====================="

             if [ ! -f "$OPENAPI_FILE" ]; then
               echo "ERROR: OpenAPI file not found:"
               echo "$OPENAPI_FILE"
               exit 1
             fi

             echo ""
             echo "Endpoints in OpenAPI:"

             jq -r '
               .paths
               | to_entries[]
               | .key as $path
               | .value
               | keys[]
               | "\(. | ascii_upcase) \($path)"
             ' "$OPENAPI_FILE"

              echo ""
              echo "====================="
              echo "Importing OpenAPI into APIM"
              echo "====================="

              az apim api import \
                --resource-group "$(apimResourceGroup)" \
                --service-name "$(apimServiceName)" \
                --api-id "$(apimApiId)" \
                --path "$(apimApiPath)" \
                --display-name "$(apimApiId)" \
                --specification-format OpenApiJson \
                --specification-path "$OPENAPI_FILE"

              echo ""
              echo "✅ OpenAPI import completed successfully."
        - bash: |
            set -euo pipefail

            SCRIPT_FILE="$(Build.SourcesDirectory)/scripts/apply-apim-operation-policies.sh"
            POLICY_FILE="$(Build.SourcesDirectory)/infra/global-policy.xml"

            echo "=========================="
            echo "APIM Automation File Validation"
            echo "=========================="

            echo ""
            echo "Normalizing CRLF -> LF..."
            sed -i 's/\r$//' "${SCRIPT_FILE}"

            echo "Normalizing policy XML..."
            sed -i 's/\r$//' "${POLICY_FILE}"

            echo ""
            echo "Script:"
            file "${SCRIPT_FILE}"

            echo ""
            echo "Policy:"
            file "${POLICY_FILE}"

            echo ""
            echo "validating bash syntax..."
            bash -n "${SCRIPT_FILE}"

            echo ""
            echo "checking polciy file..."

            if [ ! -f "${POLICY_FILE}" ]; then
              echo "##vso[task.logissue type=error]Policy file not found: ${POLICY_FILE}"
              exit 1
            fi

            if ! grep -q "<policies>" "${POLICY_FILE}"; then
              echo "##vso[task.logissue type=error]Invalid APIM policy file"
              exit 1
            fi

            if ! grep -q "<allowed-methods>" "${POLICY_FILE}"; then
              echo "##vso[task.logissue type=error]allowed-methods not found in policy file: ${POLICY_FILE}"
              exit 1
            fi

            chmod +x "${SCRIPT_FILE}"

            echo ""
            echo "APIM script and policy file validation completed successfully."
          displayName: Normalize and Validate APIM Script and Policy
        - task: AzureCLI@2
          displayName: Apply and Verify Method-Specific Policies
          inputs:
            azureSubscription: $(azureSubscription)
            scriptType: bash
            scriptLocation: scriptPath
            scriptPath: $(Build.SourcesDirectory)/scripts/apply-apim-operation-policies.sh
            workingDirectory: $(Build.SourcesDirectory)
          env:
            APIM_RESOURCE_GROUP: $(apimResourceGroup)
            APIM_SERVICE_NAME: $(apimServiceName)
            APIM_API_ID: $(apimApiId)
            APIM_POLICY_FILE: $(Build.SourcesDirectory)/infra/global-policy.xml 
                    
        - task: AzureCLI@2
          displayName: Verify Imported API
          inputs:
            azureSubscription: $(azureSubscription)
            scriptType: bash
            scriptLocation: inlineScript
            inlineScript: |

              az apim api show \
                --resource-group "$(apimResourceGroup)" \
                --service-name "$(apimServiceName)" \
                --api-id "$(apimApiId)" \
                --query "{Name:name,Path:path,DisplayName:displayName}" \
                -o table
  
