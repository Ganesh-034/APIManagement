trigger:
  branches:
    include:
      - development
  paths:
    include:
      - src/**
      - Dockerfile
      - package*.json
pr:
  branches:
    include:
      - development
pool:
  vmImage: ubuntu-latest
variables:
  azureSubscription: AzureServiceConnection
  apimResourceGroup: soc-watchtower-prod
  apimServiceName: soc-watchtower-api
  apimApiId: soc-watchtower-backend-dev
  apimApiPath: dev
  nodeVersion: 22.x
  minCodeCoverage: 80
  gitleaksVersion: v8.18.3
  EnableCodeQuality: "false"
  EnableUnitTests: "false"
  EnableNpmAudit: "true"
  EnableMSDO: "false"
  EnableGitLeaks: "true"
  EnableTrivy: "false"
  
  watchtower.rgName: soc-watchtower-dev
  watchtower.appName: soc-watchtower-backend-dev
  watchtower.appUrl: https://soc-watchtower-backend-dev-epfsh5f4fcbgbsd4.southeastasia-01.azurewebsites.net
  watchtower.registryName: acrsocwatchtowerbackenddev
  watchtower.containerRepository: soc-watchtower-backend
  watchtower.dockerfilePath: Dockerfile
  watchtower.appPort: "5000"
  watchtower.smokeTestPath: /health
  
  presidio.rgName: soc-watchtower-dev
  presidio.appName: presidio-webapi
  presidio.registryName: acrsocwatchtowerbackenddev
  presidio.containerRepository: presidioapp
  presidio.dockerfilePath: src/services/security/presidio/Dockerfile
  presidio.appPort: "86"
  presidio.smokeTestPath: /health

stages:
  - stage: DetectChanges
    displayName: Detect Changes
    jobs:
      - job: PathAnalysis
        displayName: Analyze Paths
        steps:
          - checkout: self
            fetchDepth: 0
          - bash: >
              set -euo pipefail


              echo "=============================================="

              echo "   DEVELOPMENT BRANCH"

              echo "   Quality checks are INFORMATIONAL"

              echo "=============================================="

              echo ""


              # Get changed files

              if [ "$(Build.Reason)" == "PullRequest" ]; then
                BASE_COMMIT="origin/development"
                git fetch origin development 2>/dev/null || true
              else
                BASE_COMMIT="HEAD~1"
                git rev-parse HEAD~1 >/dev/null 2>&1 || BASE_COMMIT=""
              fi


              CHANGED_FILES=""

              [ -n "${BASE_COMMIT}" ] && CHANGED_FILES=$(git diff --name-only ${BASE_COMMIT} HEAD 2>/dev/null || echo "")


              # Decide what to build

              if [ -z "${CHANGED_FILES}" ] || [ "$(Build.Reason)" == "Manual" ]; then
                echo "Building ALL services"
                echo "##vso[task.setvariable variable=deployWatchtower;isOutput=true]true"
                echo "##vso[task.setvariable variable=deployPresidio;isOutput=true]true"
              else
                DEPLOY_WATCHTOWER=false
                DEPLOY_PRESIDIO=false
                
                while IFS= read -r file; do
                  # Watchtower
                  if [[ "$file" =~ ^src/(controllers|models|routes|utils|middleware|config)/ ]] || \
                     [[ "$file" =~ ^src/services/ && ! "$file" =~ ^src/services/security/ ]] || \
                     [[ "$file" == "src/app.js" ]] || \
                     [[ "$file" == "package.json" ]] || \
                     [[ "$file" == "Dockerfile" ]]; then
                    DEPLOY_WATCHTOWER=true
                  fi
                  
                  # Presidio
                  [[ "$file" =~ ^src/services/security/ ]] && DEPLOY_PRESIDIO=true
                done <<< "$CHANGED_FILES"
                
                echo "Watchtower: ${DEPLOY_WATCHTOWER}"
                echo "Presidio: ${DEPLOY_PRESIDIO}"
                
                echo "##vso[task.setvariable variable=deployWatchtower;isOutput=true]${DEPLOY_WATCHTOWER}"
                echo "##vso[task.setvariable variable=deployPresidio;isOutput=true]${DEPLOY_PRESIDIO}"
              fi
            name: DetectPaths
            displayName: Detect Paths
  - stage: CodeQuality
    displayName: Code Quality
    dependsOn: DetectChanges
    condition: |
      and(
        succeeded(),
        eq(variables['EnableCodeQuality'], 'true')
      )
    jobs:
      - job: ESLint
        displayName: ESLint
        steps:
          - checkout: self
          - task: NodeTool@0
            inputs:
              versionSpec: $(nodeVersion)
            displayName: Install Node.js
          - bash: >
              set -euo pipefail


              echo "Installing dependencies..."

              npm ci


              # Check if ESLint config exists

              if [ ! -f ".eslintrc.js" ] && [ ! -f ".eslintrc.json" ] && [ ! -f ".eslintrc.yml" ] && [ ! -f "eslint.config.js" ]; then
                echo "No ESLint configuration found"
                echo "##vso[task.logissue type=warning]No ESLint configuration found"
                
                # Create empty report for artifact publishing
                mkdir -p reports
                echo '{"status":"skipped","reason":"No ESLint configuration found"}' > reports/eslint.json
                exit 0
              fi


              # Ensure reports directory exists

              mkdir -p reports


              echo "Running ESLint..."


              # Run ESLint with JSON output

              npx eslint "src/**/*.{js,ts}" \
                --format json \
                --output-file reports/eslint.json 2>&1 || ESLINT_EXIT=$?

              # Ensure file was created (even if ESLint failed)

              if [ ! -f reports/eslint.json ]; then
                echo '[]' > reports/eslint.json
              fi


              # Also show console output

              npx eslint "src/**/*.{js,ts}" --format stylish || true


              # Parse and report results

              if [ -f reports/eslint.json ]; then
                ERRORS=$(jq '[.[] | .errorCount] | add // 0' reports/eslint.json 2>/dev/null || echo "0")
                WARNINGS=$(jq '[.[] | .warningCount] | add // 0' reports/eslint.json 2>/dev/null || echo "0")
                
                echo ""
                echo "======================================"
                echo "ESLint Results:"
                echo "  Errors:   ${ERRORS}"
                echo "  Warnings: ${WARNINGS}"
                echo "======================================"
                
                if [ "${ERRORS}" != "0" ] && [ "${ERRORS}" -gt 0 ]; then
                  echo "##vso[task.logissue type=warning]ESLint found ${ERRORS} error(s) - NOT BLOCKING"
                fi
                
                if [ "${WARNINGS}" != "0" ] && [ "${WARNINGS}" -gt 0 ]; then
                  echo "##vso[task.logissue type=warning]ESLint found ${WARNINGS} warning(s)"
                fi
              fi


              echo ""

              echo "✓ ESLint check completed (informational)"
            displayName: Run ESLint
            continueOnError: true
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/reports/eslint.json
              artifactName: eslint-report
            displayName: Publish ESLint Report
      - job: Prettier
        displayName: Prettier
        steps:
          - checkout: self
          - task: NodeTool@0
            inputs:
              versionSpec: $(nodeVersion)
            displayName: Install Node.js
          - bash: >
              set -euo pipefail


              echo "Installing dependencies..."

              npm ci


              # Ensure reports directory exists

              mkdir -p reports


              # Check if Prettier config exists

              if [ ! -f ".prettierrc" ] && [ ! -f ".prettierrc.json" ] && [ ! -f ".prettierrc.yml" ] && [ ! -f "prettier.config.js" ]; then
                echo "No Prettier configuration found, using defaults"
              fi


              echo "Running Prettier check..."


              # Run Prettier and capture output

              npx prettier --check "src/**/*.{js,ts,json}" > reports/prettier.txt 2>&1 || PRETTIER_EXIT=$?


              # Ensure file exists

              if [ ! -f reports/prettier.txt ]; then
                echo "No output from Prettier" > reports/prettier.txt
              fi


              # Show output

              cat reports/prettier.txt


              if [ "${PRETTIER_EXIT:-0}" -ne 0 ]; then
                echo ""
                echo "##vso[task.logissue type=warning]Formatting issues detected - NOT BLOCKING"
                echo ""
                echo "To fix: npx prettier --write "src/**/*.{js,ts,json}""
              else
                echo ""
                echo "✓ All files properly formatted"
              fi
            displayName: Run Prettier
            continueOnError: true
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/reports/prettier.txt
              artifactName: prettier-report
            displayName: Publish Prettier Report
  
  - stage: UnitTests
    displayName: Unit Tests
    dependsOn: DetectChanges
    condition: |
      and(
        succeeded(),
        eq(variables['EnableUnitTests'], 'true')
      )
    jobs:
      - job: Tests
        displayName: Run Tests
        timeoutInMinutes: 10
        steps:
          - checkout: self
            fetchDepth: 1
            
          - task: NodeTool@0
            inputs:
              versionSpec: $(nodeVersion)
            displayName: Install Node.js
            
          - bash: |
              # Get npm cache directory
              NPM_CACHE_DIR=$(npm config get cache)
              echo "NPM Cache Directory: ${NPM_CACHE_DIR}"
              echo "##vso[task.setvariable variable=NPM_CACHE_FOLDER]${NPM_CACHE_DIR}"
            displayName: Get npm cache directory
            
          - task: Cache@2
            displayName: Cache npm
            inputs:
              key: 'npm | "$(Agent.OS)" | package-lock.json'
              restoreKeys: |
                npm | "$(Agent.OS)"
              path: $(NPM_CACHE_FOLDER)
            continueOnError: true
              
          - task: Cache@2
            displayName: Cache Jest
            inputs:
              key: 'jest | "$(Agent.OS)" | package-lock.json'
              restoreKeys: |
                jest | "$(Agent.OS)"
              path: $(System.DefaultWorkingDirectory)/.jest-cache
            continueOnError: true
            
          - bash: |
              set -euo pipefail
              
              echo "======================================"
              echo "Installing Dependencies"
              echo "======================================"
              
              npm ci --prefer-offline --no-audit --no-fund
              
              if ! npm list jest-junit --depth=0 > /dev/null 2>&1; then
                npm install --save-dev --no-save jest-junit
              fi
              
              echo "✓ Dependencies installed"
            displayName: Install Dependencies
            
          - bash: |
              set -euo pipefail

              echo "======================================"
              echo "Running Unit Tests (ES Modules)"
              echo "======================================"
              
              mkdir -p test-results coverage

              # Check environment
              NODE_VERSION=$(node --version)
              echo "Node.js version: ${NODE_VERSION}"
              echo ""

              # Verify package.json configuration
              if grep -q '"type": "module"' package.json; then
                echo "✓ ES Modules enabled in package.json"
              fi

              if grep -q 'test:ci' package.json; then
                echo "✓ test:ci script found"
              fi
              echo ""

              # ✅ Use npm script instead of direct npx jest
              echo "Discovering tests..."
              npm run test:ci -- --listTests 2>&1 | tee test-list.txt
              
              TEST_COUNT=$(cat test-list.txt | grep -c "\.test\.js\|\.spec\.js" || echo "0")
              
              if [ "$TEST_COUNT" -eq 0 ]; then
                echo "##vso[task.logissue type=error]No tests discovered"
                exit 1
              fi
              
              echo ""
              echo "✓ Jest discovered ${TEST_COUNT} test file(s)"
              echo ""
              
              # Show sample test files
              echo "Sample test files:"
              grep "\.test\.js\|\.spec\.js" test-list.txt | head -5
              if [ "$TEST_COUNT" -gt 5 ]; then
                echo "... and $((TEST_COUNT - 5)) more"
              fi
              echo ""

              # Determine workers
              CPU_COUNT=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 2)
              WORKER_COUNT=$((CPU_COUNT > 4 ? CPU_COUNT / 2 : CPU_COUNT))
              echo "Using ${WORKER_COUNT} workers (${CPU_COUNT} CPUs available)"
              echo ""

              # ✅ Run tests using npm script (already has NODE_OPTIONS configured)
              echo "Starting test execution..."
              START=$(date +%s)
              
              npm run test:ci -- \
                --coverage \
                --maxWorkers=${WORKER_COUNT} \
                --colors \
                2>&1 | tee test-output.log
              
              TEST_EXIT=$?

              END=$(date +%s)
              DURATION=$((END - START))
              
              echo ""
              echo "======================================"
              echo "Tests completed in ${DURATION}s"
              echo "======================================"

              # Validate junit.xml exists
              if [ ! -f test-results/junit.xml ]; then
                echo ""
                echo "##vso[task.logissue type=error]junit.xml not found"
                echo "Expected location: test-results/junit.xml"
                
                # Search for it
                echo ""
                echo "Searching for junit.xml..."
                find . -name "junit.xml" -type f 2>/dev/null | head -5
                
                exit 1
              fi

              # Parse test results
              FILE_SIZE=$(stat -c%s test-results/junit.xml 2>/dev/null || stat -f%z test-results/junit.xml 2>/dev/null || echo "0")
              echo ""
              echo "✓ Test results file (${FILE_SIZE} bytes)"
              
              if command -v xmllint > /dev/null 2>&1; then
                TOTAL=$(xmllint --xpath 'string(//testsuites/@tests)' test-results/junit.xml 2>/dev/null || echo "0")
                FAILURES=$(xmllint --xpath 'string(//testsuites/@failures)' test-results/junit.xml 2>/dev/null || echo "0")
                ERRORS=$(xmllint --xpath 'string(//testsuites/@errors)' test-results/junit.xml 2>/dev/null || echo "0")
                SKIPPED=$(xmllint --xpath 'string(//testsuites/@skipped)' test-results/junit.xml 2>/dev/null || echo "0")
                
                PASSED=$((TOTAL - FAILURES - ERRORS - SKIPPED))
                
                echo ""
                echo "Test Summary:"
                echo "  Total:    ${TOTAL}"
                echo "  Passed:   ${PASSED}"
                echo "  Failed:   ${FAILURES}"
                echo "  Errors:   ${ERRORS}"
                echo "  Skipped:  ${SKIPPED}"
              fi

              # Validate coverage exists
              if [ ! -f coverage/coverage-summary.json ]; then
                echo ""
                echo "##vso[task.logissue type=error]No coverage summary generated"
                exit 1
              fi

              # Parse coverage
              echo ""
              echo "======================================"
              echo "Coverage Summary"
              echo "======================================"
              
              COVERAGE=$(jq -r '.total.lines.pct // "0"' coverage/coverage-summary.json)
              BRANCHES=$(jq -r '.total.branches.pct // "0"' coverage/coverage-summary.json)
              FUNCTIONS=$(jq -r '.total.functions.pct // "0"' coverage/coverage-summary.json)
              STATEMENTS=$(jq -r '.total.statements.pct // "0"' coverage/coverage-summary.json)
              
              echo "Lines:      ${COVERAGE}%"
              echo "Branches:   ${BRANCHES}%"
              echo "Functions:  ${FUNCTIONS}%"
              echo "Statements: ${STATEMENTS}%"
              
              # Validate coverage is numeric
              if [[ "${COVERAGE}" =~ ^[0-9]+\.?[0-9]*$ ]]; then
                COVERAGE_INT=$(printf "%.0f" "${COVERAGE}")
                MIN_COVERAGE=70  # From jest.config.js
                
                if [ "${COVERAGE_INT}" -lt "${MIN_COVERAGE}" ]; then
                  echo ""
                  echo "##vso[task.logissue type=error]Coverage ${COVERAGE}% below minimum ${MIN_COVERAGE}%"
                  echo ""
                  echo "Note: Build will fail due to coverage threshold"
                else
                  echo ""
                  echo "✓ Coverage meets minimum requirement (${MIN_COVERAGE}%)"
                fi
              else
                echo ""
                echo "##vso[task.logissue type=warning]Invalid coverage value: ${COVERAGE}"
              fi

              # Check for cobertura
              if [ ! -f coverage/cobertura-coverage.xml ]; then
                echo ""
                echo "##vso[task.logissue type=warning]cobertura-coverage.xml not found"
                echo "Azure DevOps coverage display may not work"
              else
                COB_SIZE=$(stat -c%s coverage/cobertura-coverage.xml 2>/dev/null || stat -f%z coverage/cobertura-coverage.xml 2>/dev/null || echo "0")
                echo ""
                echo "✓ Cobertura report (${COB_SIZE} bytes)"
              fi

              # Handle test failures
              if [ "${TEST_EXIT}" -ne 0 ]; then
                echo ""
                echo "======================================"
                echo "❌ TESTS FAILED"
                echo "======================================"
                echo ""
                
                # Show failed test suites
                if grep -q "FAIL " test-output.log; then
                  echo "Failed test suites:"
                  grep "FAIL " test-output.log | head -20
                  echo ""
                fi
                
                # Show summary from Jest
                if grep -q "Test Suites:" test-output.log; then
                  echo "Jest Summary:"
                  grep -A 3 "Test Suites:" test-output.log | tail -4
                  echo ""
                fi
                
                # Show last lines
                echo "Last 50 lines of output:"
                tail -50 test-output.log
                
                exit 1
              fi

              echo ""
              echo "======================================"
              echo "✅ All tests passed!"
              echo "======================================"
            displayName: Run Tests
            env:
              NODE_ENV: test
              CI: true
              
          - task: PublishTestResults@2
            condition: always()
            inputs:
              testResultsFormat: JUnit
              testResultsFiles: '**/junit.xml'
              searchFolder: $(System.DefaultWorkingDirectory)
              failTaskOnFailedTests: false
              failTaskOnFailureToPublishResults: false
              failTaskOnMissingResultsFile: false
              testRunTitle: 'Unit Tests - $(Build.BuildNumber)'
              mergeTestResults: true
              publishRunAttachments: true
            displayName: Publish Test Results
            
          - task: PublishCodeCoverageResults@1
            condition: always()
            inputs:
              codeCoverageTool: Cobertura
              summaryFileLocation: '$(System.DefaultWorkingDirectory)/coverage/cobertura-coverage.xml'
              reportDirectory: '$(System.DefaultWorkingDirectory)/coverage'
              failIfCoverageEmpty: false
            displayName: Publish Coverage
            continueOnError: true

  - stage: Security
    displayName: Security
    dependsOn: DetectChanges
    jobs:
      - job: NPMAudit
        displayName: NPM Audit
        condition: eq(variables['EnableNpmAudit'], 'true')
        steps:
          - checkout: self
          - task: NodeTool@0
            inputs:
              versionSpec: $(nodeVersion)
            displayName: Install Node.js
          - bash: >
              set -euo pipefail


              echo "======================================"

              echo "   NPM SECURITY AUDIT"

              echo "======================================"

              echo ""


              # Ensure reports directory exists

              mkdir -p reports


              echo "Running npm audit..."

              npm audit --json > reports/npm-audit.json 2>&1 || true


              # Ensure file exists

              if [ ! -f reports/npm-audit.json ]; then
                echo '{"error":"npm audit failed to generate report"}' > reports/npm-audit.json
              fi


              # Parse results

              if jq -e '.metadata' reports/npm-audit.json >/dev/null 2>&1; then
                CRITICAL=$(jq '.metadata.vulnerabilities.critical // 0' reports/npm-audit.json)
                HIGH=$(jq '.metadata.vulnerabilities.high // 0' reports/npm-audit.json)
                MODERATE=$(jq '.metadata.vulnerabilities.moderate // 0' reports/npm-audit.json)
                LOW=$(jq '.metadata.vulnerabilities.low // 0' reports/npm-audit.json)
                TOTAL=$(jq '.metadata.vulnerabilities.total // 0' reports/npm-audit.json)
              else
                echo "Unable to parse audit results"
                CRITICAL=0
                HIGH=0
                MODERATE=0
                LOW=0
                TOTAL=0
              fi


              echo "======================================"

              echo "Vulnerability Summary:"

              echo "  Critical:  ${CRITICAL}"

              echo "  High:      ${HIGH}"

              echo "  Moderate:  ${MODERATE}"

              echo "  Low:       ${LOW}"

              echo "  Total:     ${TOTAL}"

              echo "======================================"

              echo ""


              if [ "${CRITICAL}" -gt 0 ]; then
                echo "##vso[task.logissue type=error]Found ${CRITICAL} CRITICAL vulnerabilities"
                exit 1
              fi


              if [ "${HIGH}" -gt 0 ]; then
                echo "##vso[task.logissue type=error]Found ${HIGH} HIGH vulnerabilities"
                exit 1
              fi


              if [ "${TOTAL}" -gt 0 ]; then
                echo ""
                echo "Detailed vulnerabilities:"
                npm audit || true
              else
                echo "✓ No vulnerabilities found"
              fi
            displayName: NPM Audit
            continueOnError: false
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/reports/npm-audit.json
              artifactName: npm-audit-report
            displayName: Publish NPM Audit Report
      
      - job: GitLeaks
        displayName: GitLeaks Secret Scan
        condition: eq(variables['EnableGitLeaks'], 'true')
        timeoutInMinutes: 15
        steps:
          - checkout: self
            fetchDepth: 0
            clean: true
            persistCredentials: false
          - bash: >
              set -euo pipefail

              echo "Installing GitLeaks $(gitleaksVersion)..."

              GITLEAKS_VERSION=$(echo "$(gitleaksVersion)" | sed 's/^v//')

              wget -q "https://github.com/gitleaks/gitleaks/releases/download/$(gitleaksVersion)/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"

              tar -xzf "gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz"

              sudo install -m 755 gitleaks /usr/local/bin/gitleaks

              gitleaks version
            displayName: Install GitLeaks
          - bash: >
              set -euo pipefail


              # Force fresh start

              rm -rf reports .gitleaks-cache

              mkdir -p reports


              echo "Scanning for secrets..."

              echo "Build: $(Build.BuildId)"

              echo "Commit: $(Build.SourceVersion)"

              echo ""


              # Scan without cache
              echo "================================="
              echo "Repository Information"
              echo "================================="

              echo "Build ID: $(Build.BuildId)"
              echo "Commit: $(Build.SourceVersion)"

              git log --oneline -1

              echo ""
              echo "README count"

              find . -name "README.md"

              echo ""
              echo "Root README lines"

              wc -l README.md || true

              gitleaks detect \
                --source . \
                --config .gitleaks.toml \
                --report-path reports/gitleaks.json \
                --report-format json \
                --no-git \
                --redact \
                --verbose \
                2>&1 | tee reports/gitleaks.log || true

              # Ensure valid JSON

              if [ ! -f reports/gitleaks.json ] || ! jq empty reports/gitleaks.json 2>/dev/null; then
                echo '[]' > reports/gitleaks.json
              fi


              # Report results

              LEAK_COUNT=$(jq 'length' reports/gitleaks.json)

              echo "##vso[task.setvariable variable=secretCount;isOutput=true]${LEAK_COUNT}"


              if [ "${LEAK_COUNT}" -gt 0 ]; then
                echo "Found ${LEAK_COUNT} potential secrets"
                jq -r '.[] | "\(.File):\(.StartLine) [\(.RuleID)]"' reports/gitleaks.json

                echo "##vso[task.logissue type=error]GitLeaks detected secrets"
                exit 1
              else
                echo "No secrets detected"
              fi
            name: Scan
            displayName: Scan Repository
            continueOnError: false
          - task: PublishPipelineArtifact@1
            condition: always()
            inputs:
              targetPath: $(System.DefaultWorkingDirectory)/reports
              artifactName: gitleaks-$(Build.BuildId)
            displayName: Publish Report
      - job: MSDO
        displayName: Microsoft Security DevOps
        condition: eq(variables['EnableMSDO'], 'true')
        steps:
          - checkout: self
          - bash: |
              echo "======================================"
              echo "   MICROSOFT SECURITY DEVOPS"
              echo "======================================"
              echo ""
            displayName: MSDO Info
          - task: MicrosoftSecurityDevOps@1
            displayName: Run MSDO Analysis
            continueOnError: true
            inputs:
              categories: secrets,code,dependencies,containers,IaC
              break: false
          - task: PublishPipelineArtifact@1
            displayName: Publish MSDO Results
            condition: always()
            inputs:
              targetPath: $(Build.SourcesDirectory)/.gdn
              artifactName: msdo-results
  
  - stage: Build_Watchtower
    displayName: Build Watchtower
    dependsOn: 
      - DetectChanges
      - Security
    condition: >
      and(
        succeeded(),
        eq(dependencies.DetectChanges.outputs['PathAnalysis.DetectPaths.deployWatchtower'], 'true')
      )
    jobs:
      - job: Build
        displayName: Build & Push
        steps:
          - checkout: self
          - task: NodeTool@0
            inputs:
              versionSpec: $(nodeVersion)
            displayName: Install Node.js
          - bash: |
              set -euo pipefail
              npm ci
              npm run generate-openapi
              echo "Generated files:"
              find . -name "*.json" | grep -i openapi || true

              echo ""
              echo "openapi folder contents:"
              ls -la openapi || true
            displayName: Generate OpenAPI

          - task: PublishPipelineArtifact@1
            displayName: Publish OpenAPI Files
            inputs:
              targetPath: openapi
              artifactName: openapi-files
          - bash: |
              set -euo pipefail
              echo "Regenerating package-lock.json..."
              rm -rf node_modules package-lock.json
              npm install --package-lock-only
            displayName: Generate Lock File
          - task: AzureCLI@2
            name: BuildPush
            displayName: Build & Push Image
            inputs:
              azureSubscription: $(azureSubscription)
              scriptType: bash
              scriptLocation: inlineScript
              inlineScript: >
                set -euo pipefail


                ACR="$(watchtower.registryName)"

                REPO="$(watchtower.containerRepository)"

                TAG="$(Build.BuildId)"

                IMAGE="${ACR}.azurecr.io/${REPO}:${TAG}"


                BUILD_DATE=$(date -u +'%Y-%m-%dT%H:%M:%SZ')

                GIT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "unknown")


                echo "======================================"

                echo "Building Watchtower Image"

                echo "======================================"

                echo "Image: ${IMAGE}"

                echo "Commit: ${GIT_COMMIT}"

                echo ""


                az acr login --name "${ACR}"


                docker build \
                  --build-arg BUILD_DATE="${BUILD_DATE}" \
